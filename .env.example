# Schwab developer credentials. Get these from developer.schwab.com after
# your individual developer app is approved.
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here

# The callback URL you registered on the Schwab app. Must match EXACTLY,
# including the trailing slash.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/

# Where to write the OAuth tokens file. Keep it out of git.
SCHWAB_TOKEN_PATH=./tokens.json

# Optional: pin to one account by accountNumber. Leave blank if you have a
# single account. With multiple accounts and this unset, the client raises a
# clear error rather than guessing which one to read.
SCHWAB_BOT_ACCOUNT_NUMBER=
